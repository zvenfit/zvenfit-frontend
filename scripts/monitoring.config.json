{
  "project": "folder__b1ge1e4iopttj79hfdfm",
  "source": {
    "cluster": "default",
    "service": "default",
    "labels": {
      "meta.application": "zvenfit-frontend",
      "meta.environment": "production"
    },
    "retentionDays": 3
  },
  "metricOutput": {
    "cluster": "default",
    "service": "logging_aggregates",
    "idLabel": "name"
  },
  "trafficAnalytics": {
    "cdnResourceId": "bc8rubabuwzpqqp7rifz",
    "siteHosts": [
      "zvenfit.ru",
      "www.zvenfit.ru",
      "zvenigorod.zvenfit.ru"
    ],
    "rawLogBucket": "zvenfit-cdn-access-logs",
    "rawLogPrefix": "raw/zvenfit/cdn",
    "rawLogRetentionDays": 30,
    "queryFile": "analytics/cdn-traffic.yql",
    "queryBinding": "zvenfit-cdn-raw-logs",
    "trafficClasses": [
      "browser_like",
      "known_bot",
      "synthetic",
      "unknown"
    ],
    "measures": ["requests", "page_views"],
    "datalens": {
      "refreshCadence": "manual-2-or-3-times-daily",
      "cards": {
        "lastReceivedLog": {
          "title": "Последний полученный лог",
          "visualization": "indicator",
          "measure": "MAX(log_timestamp)",
          "pagingAlert": false
        }
      }
    },
    "monitoringSelectors": {
      "edgeRequests": "edge.requests{service=\"yccdn\",resource=\"bc8rubabuwzpqqp7rifz\"}",
      "edgeStatus": "edge.requests_status{service=\"yccdn\",resource=\"bc8rubabuwzpqqp7rifz\"}",
      "edgeCache": "edge.requests_cache_status{service=\"yccdn\",resource=\"bc8rubabuwzpqqp7rifz\"}",
      "edgeBytes": "edge.bytes_sent{service=\"yccdn\",resource=\"bc8rubabuwzpqqp7rifz\"}",
      "edgeLatency": "edge.request_time_seconds{service=\"yccdn\",resource=\"bc8rubabuwzpqqp7rifz\"}"
    },
    "privacy": {
      "rawIpInDataset": false,
      "rawUserAgentInDataset": false,
      "rawUrlInDataset": false
    }
  },
  "provisioning": {
    "logMetrics": "manual-console",
    "notificationChannels": "manual-console",
    "alerts": "manual-console",
    "reason": "Yandex Monitoring does not expose these resources in the public YC CLI or Terraform provider"
  },
  "notificationChannels": [
    {
      "id": "zvenfit_telegram_alerts",
      "name": "ZvenFit Telegram alerts",
      "method": "telegram",
      "recipient": "cloud-account",
      "sendScreenshot": true
    },
    {
      "id": "zvenfit_email_alerts",
      "name": "ZvenFit Email alerts",
      "method": "email",
      "recipient": "cloud-account"
    }
  ],
  "notificationPolicy": {
    "statuses": ["ALARM", "WARNING", "OK"],
    "repeatMinutes": 30
  },
  "logMetrics": [
    {
      "id": "zvenfit_lead_storage_errors_1m",
      "events": ["lead_storage_error", "telegram_delivery_retry_error"],
      "aggregation": "count",
      "window": "1m"
    },
    {
      "id": "zvenfit_telegram_delivery_failed_1m",
      "events": ["telegram_delivery_failed_permanently"],
      "aggregation": "count",
      "window": "1m"
    },
    {
      "id": "zvenfit_fitbase_errors_5m",
      "events": ["fitbase_schedule_error", "fitbase_schedule_misconfigured"],
      "aggregation": "count",
      "window": "5m"
    },
    {
      "id": "zvenfit_ydb_retries_5m",
      "events": ["ydb_retry"],
      "aggregation": "count",
      "window": "5m"
    },
    {
      "id": "zvenfit_ydb_slow_operations_5m",
      "events": ["ydb_slow_operation"],
      "aggregation": "count",
      "window": "5m"
    },
    {
      "id": "zvenfit_rate_limit_errors_5m",
      "events": ["lead_rate_limit_error"],
