# Dependencies
node_modules/

# Build output
dist/
upload/
functions/*/build/

# Environment (keep .env.example tracked)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

