# Copy to .env.development for local dev (gitignored)

# --- Build (npm run build / dev) ---
# Dev defaults: http://localhost:3000 and http://localhost:3000/schedule
LEAD_API_URL=
SCHEDULE_API_URL=
NODE_ENV=development
ASSET_VERSION=dev

# Yandex Maps JS API (optional locally; set in GitHub vars for prod)
Y_MAPS_API_KEY=

# --- Schedule provider: dynamic fixture by default; fitbase is optional locally ---
SCHEDULE_PROVIDER=fixture
FITBASE_API_TOKEN=
FITBASE_DOMAIN=zvenfit
FITBASE_CLUB_ID=

# --- Local deploy to Yandex Object Storage (optional) ---
YC_S3_BUCKET=zvenfit-frontend
YC_ACCESS_KEY_ID=
YC_SECRET_ACCESS_KEY=

# --- Local deploy Cloud Functions (optional) ---
YC_FOLDER_ID=
YC_LEAD_SERVICE_ACCOUNT_ID=
YC_LEAD_TIMEOUT=120s
YDB_DATABASE_NAME=zvenfit-leads
YDB_LEADS_TABLE=leads
YDB_RATE_LIMITS_TABLE=lead_rate_limits
LEAD_RATE_LIMIT_SECRET=
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW_SECONDS=600
MAX_TELEGRAM_ATTEMPTS=12
TELEGRAM_RETRY_BATCH_SIZE=5
TELEGRAM_TIMEOUT_MS=15000
YDB_QUERY_TIMEOUT_MS=5000
YDB_SLOW_OPERATION_MS=1000
YDB_SESSION_POOL_SIZE=5
MONIUM_METRICS_ENABLED=true
MONIUM_API_KEY=
MONIUM_PROJECT=
MONIUM_CLUSTER=default
MONIUM_SERVICE=zvenfit-frontend
MONIUM_METRICS_TIMEOUT_MS=1000
LOG_LEVEL=info
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALLOWED_ORIGINS=https://zvenfit.ru,https://www.zvenfit.ru,https://zvenigorod.zvenfit.ru
