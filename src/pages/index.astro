            </div>
          </div>
        </div>
        <div class="w-slide">
          <div class="slider-main">
            <div id="w-node-_4918e816-5e86-c6f8-f669-87ad0f877b60-9716bd19" class="slider_photo _3"></div>
            <div id="w-node-_4918e816-5e86-c6f8-f669-87ad0f877b61-9716bd19" class="slider_content">
