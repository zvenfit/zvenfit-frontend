            <div id="w-node-_19875391-9c51-8795-2044-bc5716b8ba7d-9716bd19" class="slider_photo _1"></div>
            <div id="w-node-b8c4977c-4f08-8a91-6a58-479a1614dd45-9716bd19" class="slider_content">
