---
import Analytics from '../components/Analytics.astro';
import Footer from '../components/Footer.astro';
import Menu from '../components/Menu.astro';
import Base from '../layouts/Base.astro';

export const sitemap = { updated: '2026-05-13', changefreq: 'weekly', priority: '1.0' };
---
<Base title="Фитнес-клуб ZvenFit в Звенигороде — зал, пилатес, персональные тренировки" description="Фитнес-клуб ZvenFit Звенигород: тренажерный зал 500м², пилатес на реформере, персональные тренировки. Рассрочка 0%, пробная тренировка 1000₽. ☎ +7 (925) 308-23-23" wfPage="697f30b77cb029a39716bd19" wfSite="697f30b67cb029a39716bd07" webflowComments="<!--  This site was created in Webflow. https://webflow.com  --><!--  Last Published: Sun Mar 22 2026 09:06:04 GMT+0000 (Coordinated Universal Time)  -->" hasMaps><meta slot="head-start" http-equiv="X-Content-Type-Options" content="nosniff" /><meta slot="head-start" name="referrer" content="strict-origin-when-cross-origin" />
  <div class="grain-overlay">
    </div>
  <Menu variant="home" wNode={{"call":"w-node-cb5099cb-a39d-b6a2-9dbf-597fb5bf5ba9-9716bd19","cta":"w-node-_7d41401a-7067-c94a-50a0-91074370b2db-9716bd19","contacts":"w-node-_3e4ebd6f-68d9-b921-883a-eec3495ae707-9716bd19"}} />
  <div data-hover="false" data-delay="0" class="dropdown w-dropdown">
    <div class="dropdown-toggle w-dropdown-toggle">
      <div class="icon-5 w-icon-dropdown-toggle"></div>
      <div class="text-block-2">связь с нами</div>
    </div>
    <nav class="dropdown-list w-dropdown-list">
      <a href="tel:+79253082323" class="dropdown-link w-dropdown-link" aria-label="Позвонить по телефону +7 (925) 308-23-23">позвонить нам</a>
      <a href="/forma-dlya-zayavki/" class="dropdown-link w-dropdown-link">оставить заявку</a>
      <a href="/contacts/platforms/" class="dropdown-link w-dropdown-link">где нас найти</a>
      <a href="/promos/" class="dropdown-link w-dropdown-link">акции</a>
      <a href="https://yandex.ru/maps/-/CPeXe80n" target="_blank" class="dropdown-link w-dropdown-link" aria-label="Показать на Яндекс Картах">показать на карте</a>
    </nav>
  </div>
  <section>
    <div class="cover_text">
      <h1 class="h1-main">zvenfit</h1>
      <p class="p1">Фитнес-клуб и пилатес на&nbsp;реформере в&nbsp;Звенигороде. Когда худеть, набирать массу и&nbsp;заботиться о&nbsp;здоровье можно в&nbsp;одном месте</p>
      <a data-popup="open" href="/forma-dlya-zayavki/" class="button open-form w-button">оставить заявку</a>
    </div>
    <div class="card_grid main">
      <a href="/trenazhernyj-zal/" class="link-block-5 w-inline-block">
        <div data-w-id="54fad0b0-df23-f129-99fc-f49ebf9b157c" class="card_l">
          <div class="text-block slash-prefix">фитнес-зал</div>
        </div>
      </a>
      <a data-w-id="74186107-57cc-848f-2b8c-da70a578d7cd" href="/gruppovye-trenirovki/" class="link-block-5 group w-inline-block">
        <div data-w-id="02177070-ecae-4ea8-1947-9361569676c0" class="card_middle">
          <div class="text-block slash-prefix">Групповые тренировки</div>
        </div>
      </a>
      <a href="/pilates-na-reformere/" class="link-block-5 w-inline-block">
        <div data-w-id="0225b22d-e0d6-784b-2ce3-effee8bd4a0a" class="card_r">
          <div class="text-block slash-prefix">Пилатес на&nbsp;реформере</div>
        </div>
      </a>
    </div>
  </section>
  <div class="divider"></div>
  <section>
    <div data-delay="4000" data-animation="slide" class="slider w-slider" data-autoplay="false" data-easing="ease" data-hide-arrows="false" data-disable-swipe="false" data-autoplay-limit="0" data-nav-spacing="3" data-duration="500" data-infinite="true">
      <div class="mask-2 w-slider-mask">
