---
import Analytics from '../../components/Analytics.astro';
import Footer from '../../components/Footer.astro';
import Menu from '../../components/Menu.astro';
import Base from '../../layouts/Base.astro';
import imask761 from '../../vendor/imask-7.6.1.min.js?url';
import leadForm from '../../scripts/lead-form.js?url';

export const sitemap = { updated: '2026-05-13', changefreq: 'monthly', priority: '0.8' };
---
<Base title="Запись в ZvenFit — Звенигород | пробное занятие 1000 ₽" description="Записаться в фитнес-клуб ZvenFit Звенигород: пробная тренировка 1000₽, консультация по абонементам. Онлайн-запись или звоните ☎ +7 (925) 308-23-23" wfPage="69afcc63a8430506c5715438" wfSite="697f30b67cb029a39716bd07" webflowComments="<!--  This site was created in Webflow. https://webflow.com  --><!--  Last Published: Sun Mar 22 2026 09:06:04 GMT+0000 (Coordinated Universal Time)  -->" hasMaps>
  <div class="grain-overlay">
    </div>
  <Menu variant="plain" secondary={{"label":"вернуться назад","href":"#","dataBack":true,"block":1}} />
  <section>
    <div class="cover_text">
      <h1 class="h1-main">zvenfit</h1>
      <p class="p1">заполните форму и&nbsp;мы с&nbsp;вами свяжемся!</p>
    </div>
    <div class="form-overlay">
      <div id="tg-send" class="sign-up-form w-form">
        <form id="wf-form-tg-send" name="wf-form-tg-send" data-name="tg-send" method="post" class="form" data-wf-page-id="69afcc63a8430506c5715438" data-wf-element-id="04cb5ca4-5a7b-e5c8-cfd5-c850a8fe8009"><label for="name" class="telegram-label">Имя</label><input class="text-field-2 w-input" autocomplete="name" maxlength="256" name="name" data-name="name" placeholder="" type="text" id="name" required=""><label for="phone" class="telegram-label">Номер</label><input class="text-field w-input" autocomplete="tel" maxlength="18" name="phone" data-name="phone" pattern="\+\d&#123;1&#125; \(\d&#123;3&#125;\) \d&#123;3&#125;-\d&#123;2&#125;-\d&#123;2&#125;" placeholder="+7 (___) ___-__-__" minlength="18" type="tel" id="phone" required=""><label for="service" class="telegram-label">Как с вами связаться?</label>
          <select id="service" name="service" class="select-field w-select">
            <option value="Позвонить">Позвонить</option>
            <option value="WhatsApp">Написать в WhatsApp</option>
            <option value="Макс">Написать в Макс</option>
            <option value="Telegram">Написать в Telegram</option>
          </select>
          <div id="telegram-contact" class="telegram-wrapper" hidden><label for="telegram_username" class="telegram-label">Ваш username в Telegram</label><input class="telegram-field w-input" maxlength="256" name="telegram_username" data-name="telegram_username" placeholder="@username" type="text" id="telegram_username" autocomplete="off"></div>
          <div aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden"><label for="company_website">Сайт компании</label><input type="text" id="company_website" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true"></div>
          <p class="smalltxt"><strong class="bold-text-2">Нажимая кнопку «Отправить», вы соглашаетесь с&nbsp;</strong>
            <a href="/privacy/" target="_blank" class="link-3"><strong class="bold-text-2">Политикой конфиденциальности</strong></a><strong class="bold-text-2"> и даёте согласие на обработку ваших персональных данных</strong>
          </p><input type="submit" data-wait="Пожалуйста, подождите..." class="submit-button w-button" value="Отправить">
        </form>
        <div class="success-message w-form-done" role="status" aria-live="polite" tabindex="-1">
          <div>Спасибо! Ваша заявка получена!</div>
        </div>
        <div class="error-message w-form-fail" role="alert" aria-live="assertive" tabindex="-1">
          <div class="error">Не удалось отправить заявку. Проверьте соединение и попробуйте ещё раз.</div>
        </div>
      </div>
    </div>
  </section>
  <div class="divider"></div>
  <Footer location="chekhova" />
  <Fragment slot="scripts"><Analytics placement="body" gtm="commented" />
  <script is:inline src={imask761} defer></script>
  <script is:inline>
document.addEventListener("DOMContentLoaded", function(){
const phoneInput = document.querySelector('[name="phone"]');
if(phoneInput && typeof IMask === 'function'){
IMask(phoneInput, {
mask: '+{7} (000) 000-00-00'
});
}
});
</script>
  <script is:inline src="/js/lead-config.js"></script>
  <script is:inline src={leadForm} defer></script>
  <script is:inline>
document.addEventListener("DOMContentLoaded", function() {
  document.querySelectorAll('[data-back]').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      if (history.length <= 1) {
        window.location.pathname = '/';
      } else {
        history.back();
      }
    });
  });
});
</script>
</Fragment></Base>
