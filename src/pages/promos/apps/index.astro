---
import Analytics from '../../../components/Analytics.astro';
import AppDownloadPromo from '../../../components/AppDownloadPromo.astro';
import Menu from '../../../components/Menu.astro';
import Base from '../../../layouts/Base.astro';

export const sitemap = { updated: '2026-07-02', changefreq: 'monthly', priority: '0.8' };
---
<Base title="Скачай приложение ZvenFit — скидка 15% на абонемент" description="Скачай приложение ZvenFit и получи скидку 15% на абонемент в фитнес-клуб. App Store, RuStore, APK для Android. Звенигород." gtm="bare">
  <div class="grain-overlay"></div>
  <Menu variant="plain" secondary={{"label":"оставить заявку","href":"/forma-dlya-zayavki/","block":4}} />
  <div data-hover="false" data-delay="0" class="dropdown2 w-dropdown">
    <div class="dropdown-toggle w-dropdown-toggle">
      <div class="icon-5 w-icon-dropdown-toggle"></div>
      <div class="text-block-2">меню</div>
    </div>
    <nav class="dropdown-list w-dropdown-list">
      <a href="/promos/" class="dropdown-link w-dropdown-link">Все акции</a>
      <a href="#mobile-app" class="dropdown-link w-dropdown-link">Скачать приложение</a>
      <a href="/forma-dlya-zayavki/" class="dropdown-link w-dropdown-link">Оставить заявку</a>
      <a href="tel:+79253082323" class="dropdown-link w-dropdown-link">Позвонить нам</a>
      <a href="#promo-terms" class="dropdown-link w-dropdown-link">Условия акции</a>
      <a href="/" class="dropdown-link w-dropdown-link">На главную</a>
    </nav>
  </div>
    <AppDownloadPromo />

  <section class="card_grid promo-apps-benefits">
    <h2 class="heading-page">зачем <span class="text-span">скачивать</span></h2>
    <div class="promo-apps-benefits__grid">
      <article class="promo-apps-benefits__card">
        <span class="promo-apps-benefits__index slash-prefix">01</span>
        <h3 class="promo-apps-benefits__title">Расписание</h3>
        <p class="promo-apps-benefits__text">Смотрите актуальное расписание групповых и персональных тренировок в любое время</p>
      </article>
      <article class="promo-apps-benefits__card">
        <span class="promo-apps-benefits__index slash-prefix">02</span>
        <h3 class="promo-apps-benefits__title">Абонемент</h3>
        <p class="promo-apps-benefits__text">Оформите первый абонемент на ресепшене — скидку 15% применит администратор при установленном приложении</p>
      </article>
      <article class="promo-apps-benefits__card">
        <span class="promo-apps-benefits__index slash-prefix">03</span>
        <h3 class="promo-apps-benefits__title">Напоминания</h3>
        <p class="promo-apps-benefits__text">Приложение напомнит о тренировке — не пропустите занятие</p>
      </article>
    </div>
  </section>
  <section id="promo-terms" class="card_grid promo-apps-terms">
    <h2 class="heading-page">условия <span class="text-span">акции</span></h2>
    <div class="promo-apps-terms__box">
      <ul class="promo-apps-terms__list">
        <li>Скидка 15% на <strong>первый абонемент</strong> в фитнес-клуб ZvenFit — при установленном мобильном приложении.</li>
        <li>В приложении отображаются <strong>обычные цены</strong>. Скидка в приложении автоматически не применяется.</li>
        <li>Чтобы получить скидку, скачайте приложение и обратитесь к <strong>администратору на ресепшене</strong> при покупке абонемента.</li>
        <li>Скидка предоставляется <strong>один раз</strong>. Все последующие абонементы — по стандартным ценам клуба.</li>
        <li>Акция действует на <strong>абонементы в обоих клубах</strong> ZvenFit: Звенигород, ул. Чехова, 13А и Звенигород, Нахабинское шоссе, 7А. Администратор может попросить показать установленное приложение.</li>
      </ul>
    </div>
  </section>
  <Fragment slot="scripts">
  <Analytics placement="body" gtm="bare" />
</Fragment></Base>
