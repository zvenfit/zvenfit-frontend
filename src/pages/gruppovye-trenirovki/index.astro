  <Fragment slot="scripts">
  <script is:inline>
document.querySelectorAll('.reviews-section').forEach(section => {
  const wrapper = section.querySelector('.reviews-wrapper');
  const next = section.querySelector('.btn-next');
  const prev = section.querySelector('.btn-prev');
  if (!wrapper || !next || !prev) return;
  const card = wrapper.querySelector('.review');
  if (!card) return;
  const track = wrapper.querySelector('.reviews-track');
  const gap = track
    ? parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 40
    : 40;
  const scrollAmount = card.offsetWidth + gap;
  next.addEventListener('click', () => {
    wrapper.scrollBy({ left: scrollAmount, behavior: 'smooth' });
  });
  prev.addEventListener('click', () => {
    wrapper.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
  });
});
</script>
