---
// "Mobile app" section with store badges (legacy snippet
// app-download-platforms-section.html), used by the platforms page.
import appLinks from '../../scripts/app-links.config.json';
---
<section id="mobile-app" class="card_grid">
    <h2 class="heading-page">мобильное <span class="text-span">приложение</span></h2>
    <div class="app-download-block app-download-block--page">
      <div class="app-download-block__content">
        <div class="app-download-block__copy">
          <p class="app-download-block__desc">Смотрите расписание, покупайте абонемент и не пропускайте занятия — приложение напомнит.</p>
        </div>
        <div class="app-badges app-badges--page">
          <div class="app-badges__stores">
            <a href={appLinks.appStore} target="_blank" rel="noopener noreferrer" class="app-badges__link" aria-label="Скачать ZvenFit в App Store">
              <img src={appLinks.appStoreBadge} alt="" class="app-badges__img" width="140" height="48" loading="lazy">
            </a>
            <a href={appLinks.ruStore} target="_blank" rel="noopener noreferrer" class="app-badges__link" aria-label="Скачать ZvenFit в RuStore">
              <img src={appLinks.ruStoreBadge} alt="" class="app-badges__img" width="140" height="48" loading="lazy">
            </a>
            <a href={appLinks.apk} target="_blank" rel="noopener noreferrer" class="app-badges__link" aria-label="Скачать APK ZvenFit для Android">
              <img src={appLinks.apkBadge} alt="" class="app-badges__img" width="140" height="48" loading="lazy">
            </a>
          </div>
          <p class="app-download-block__note">* Если RuStore не установлен, сначала <a href="https://www.rustore.ru/" target="_blank" rel="noopener noreferrer">скачайте магазин</a>, затем — приложение. Или установите APK.</p>
        </div>
      </div>
    </div>
  </section>
  <div class="divider"></div>
