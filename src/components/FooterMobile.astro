---
// Mobile footer (Webflow section-3) of the Chekhova location.
import AppDownloadBadges from './AppDownloadBadges.astro';
import MapRegion from './MapRegion.astro';
import { legalClass, legalCurrent } from '../lib/footer';

interface Props {
  badges: boolean;
}

const { badges } = Astro.props;
const path = Astro.url.pathname;
// Legacy indentation of the badge block and the newline the snippet ended with.
const indent = '    ';
const newline = '\n';
---
<section class="section-3">
    <div class="div-block-13">
      <MapRegion />
    </div>
    <div class="txt_cont">
      <h2 class="footer">Звенигород, Чехова 13А</h2>
      <a href="tel:+79253082323" class="link-block-7 w-inline-block" aria-label="Позвонить по телефону +7 (925) 308-23-23">
        <h2 class="footer">+7 (925) 308-23-23</h2>
      </a>
      <p class="body_txt cont"><strong class="bold-text-2 foot">пн-вс: 08:00-22:00</strong></p>
      <a href="mailto:zvenfit-reception@yandex.ru" class="link _1">zvenfit-reception@yandex.ru</a>
      <a href="/privacy/" target="_blank" aria-current={legalCurrent(path, '/privacy/')} class={legalClass(path, '/privacy/', 'link')}>Политика конфиденциальности</a>
      <a href="/payment-policy/" target="_blank" aria-current={legalCurrent(path, '/payment-policy/')} class={legalClass(path, '/payment-policy/', 'link')}>Политика оплаты, возврата и&nbsp;отмены</a>
      <a href="/offer/" target="_blank" aria-current={legalCurrent(path, '/offer/')} class={legalClass(path, '/offer/', 'link text-span-2 _2')}>Публичная оферта</a>
      <a href="https://kaya-li.com" target="_blank" rel="noopener noreferrer" aria-label="Перейти на сайт автора vverlyne" class="link _2">Сайт создан <span class="text-span-2">@vverlyne&nbsp;</span>с&nbsp;любовью</a>
    </div>
        {badges && (<Fragment>{indent}<AppDownloadBadges />{newline}</Fragment>)}
    <div class="divider footer"></div>
  </section>
