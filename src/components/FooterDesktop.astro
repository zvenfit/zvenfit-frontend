---
// Desktop footer (Webflow section-4): the map, the text block of one club or
// the grid with both clubs, the app badges. Called by Footer.astro.
import AppDownloadBadges from './AppDownloadBadges.astro';
import FooterGrid from './FooterGrid.astro';
import MapRegion from './MapRegion.astro';
import { FOOTER_PLACES, GRID_BADGE_INDENT, type FooterLocation, legalClass, legalCurrent } from '../lib/footer';

interface Props {
  location: FooterLocation;
  withGrid: boolean;
  withMap: boolean;
  badges: boolean;
  anchorId?: string;
}

const { location, withGrid, withMap, badges, anchorId } = Astro.props;
const path = Astro.url.pathname;
const place = FOOTER_PLACES[location];
// Legacy whitespace around the optional blocks: the map wrapper, and the badge
// block with the indentation of its build marker plus the snippet's own.
const mapLead = '\n    ';
const mapInner = '\n      ';
const badgeLead = `\n${' '.repeat(withGrid ? GRID_BADGE_INDENT : place.badgeIndent)}`;
const newline = '\n';
---
<section id={anchorId} class="section-4">{withMap && (<Fragment>{mapLead}<div class="div-block-13">{mapInner}<MapRegion />{mapLead}</div></Fragment>)}
    <div class={withGrid ? 'txt_cont txt_cont--home' : 'txt_cont'}>
      {withGrid ? <FooterGrid section="desktop" /> : (
      <Fragment><div class="left_cont">
        <h2 class="footer">{place.address}</h2>
        <p class="body_txt cont"><strong class="bold-text-2">пн-вс: 08:00-22:00</strong></p>
        <a href="/privacy/" target="_blank" aria-current={legalCurrent(path, '/privacy/')} class={legalClass(path, '/privacy/', 'link')}>Политика конфиденциальности</a>
        <a href="/payment-policy/" target="_blank" aria-current={legalCurrent(path, '/payment-policy/')} class={legalClass(path, '/payment-policy/', 'link')}>Политика оплаты, возврата и&nbsp;отмены</a>
      </div>
      <div class="right_cont">
        <a href={place.phoneHref} class="link-block-6 w-inline-block" aria-label={`Позвонить по телефону ${place.phone}`}>
          <h2 class="footer">{place.phone}</h2>
        </a>
        <a href="mailto:zvenfit-reception@yandex.ru" class="link _1">zvenfit-reception@yandex.ru</a>
        <a href="/offer/" target="_blank" aria-current={legalCurrent(path, '/offer/')} class={legalClass(path, '/offer/', 'link text-span-2 _2')}>Публичная оферта</a>
        <a href="https://kaya-li.com" target="_blank" rel="noopener noreferrer" aria-label="Перейти на сайт автора vverlyne" class="link _2">Сайт создан&nbsp;<span class="text-span-2">@vverlyne</span>&nbsp;с&nbsp;любовью</a>
      </div></Fragment>)}
    </div>{badges && (<Fragment>{badgeLead}<AppDownloadBadges />{newline}</Fragment>)}
    <div class="divider footer"></div>
  </section>
